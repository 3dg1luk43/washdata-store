rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isGithubUser() { return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'github.com'; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isBanned() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'banned';
    }
    function canContribute() { return isGithubUser() && !isBanned(); }
    function strLen(v, max) { return v is string && v.size() >= 1 && v.size() <= max; }
    // Optional public attribution / manual URL validators (both may be null).
    function optName(v) { return v == null || (v is string && v.size() <= 100); }
    function optUrl(v) { return v == null || (v is string && v.size() <= 500 && v.matches('https?://.*')); }
    // Admin-tunable auto-approve threshold (config/site.confirmThreshold), default 5.
    // config/site is always seeded; fall back to 5 if the doc is ever missing.
    function confirmThreshold() {
      return exists(/databases/$(database)/documents/config/site)
        ? get(/databases/$(database)/documents/config/site).data.get('confirmThreshold', 5)
        : 5;
    }
    // Brands get their own auto-approve bar (config/site.brandConfirmThreshold): a brand name
    // is easier to verify than a specific model, so it is usually lower. Falls back to the
    // shared device/cycle threshold when unset, so brands behave sensibly before it is set.
    function brandConfirmThreshold() {
      return exists(/databases/$(database)/documents/config/site)
        ? get(/databases/$(database)/documents/config/site).data.get('brandConfirmThreshold',
            get(/databases/$(database)/documents/config/site).data.get('confirmThreshold', 5))
        : 5;
    }
    // Shape/identity validation for a content report. Target existence + the target*/path
    // binding are checked in each per-parent create rule (which knows the concrete path),
    // so a reporter can neither file on a non-existent object nor point a report at an
    // unrelated one.
    function reportCreateOk(reporterUid) {
      return canContribute()
        && request.auth.uid == reporterUid
        // Exactly the fields the client writes -- no junk / oversized extra keys.
        && request.resource.data.keys().hasOnly(['reporterUid', 'reporterName', 'reason',
             'comment', 'targetType', 'targetId', 'targetPath', 'parentCycleId', 'targetLabel',
             'targetCreatedByUid', 'status', 'createdAt'])
        && request.resource.data.reporterUid == reporterUid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 40
        && strLen(request.resource.data.comment, 1000)
        && request.resource.data.targetType in ['brand', 'device', 'profile', 'cycle', 'comment']
        && optName(request.resource.data.get('reporterName', null))
        && (request.resource.data.get('targetLabel', null) == null
            || (request.resource.data.targetLabel is string && request.resource.data.targetLabel.size() <= 200))
        && (request.resource.data.get('targetCreatedByUid', null) == null
            || (request.resource.data.targetCreatedByUid is string && request.resource.data.targetCreatedByUid.size() <= 128))
        && request.resource.data.createdAt == request.time;
    }

    // ---- Shape validation for contributor-created catalog data ---------------------------
    // Everything a contributor writes is rendered by the website and downloaded by the
    // integration, so the create rules below pin the field list, the types and the parent
    // links instead of trusting the client. Admin writes keep their own unrestricted branch.

    // A finite number in a sane range. NaN and +/-Infinity fail every comparison, so they are
    // rejected too (rules have no isFinite). Rules literals cannot use exponent notation.
    function finiteNum(v) { return v is number && v > -1000000000000 && v < 1000000000000; }
    function optFiniteNum(m, k) { return !(k in m) || finiteNum(m[k]); }
    // A counter the creator may only omit or initialise to zero.
    function zeroOrAbsent(m, k) { return m.get(k, 0) == 0; }
    function optText(v, max) { return v == null || (v is string && v.size() <= max); }
    // One normalised id token, exactly what lib/ids.js normalizeToken (and the integration's
    // store_client.normalize_token) can emit: letters/digits of any script and '-'. It holds
    // no '/' (so an id can never step outside its document when interpolated into a path) and
    // no regex metacharacter (so an id is safe to splice into a matches() pattern).
    function tok() { return '[\\p{L}\\p{N}-]*'; }
    // devices/{type__brand__model}; the type token is normalizeToken(applianceType), so
    // washer_dryer is spelled washer-dryer in the id.
    function isDeviceId(v) { return v is string && v.size() <= 300 && v.matches('[a-z-]+__' + tok() + '__' + tok()); }
    function isProfileId(v) { return v is string && v.size() <= 400 && v.matches('[a-z-]+__' + tok() + '__' + tok() + '__' + tok()); }
    function idOfType(id, type) { return id.matches(type.replace('_', '-') + '__.*'); }
    function applianceTypeOk(t) { return t in ['washer', 'dryer', 'dishwasher', 'washer_dryer']; }

    // Shared device settings: the integration's SHAREABLE_SETTING_KEYS (+ the retired
    // running_dead_zone the web editor still lists), each a non-negative finite number.
    function settingOk(s, k) { return !(k in s) || (s[k] is number && s[k] >= 0 && s[k] <= 1000000000); }
    function settingsOk(s) {
      return s is map
        && s.keys().hasOnly(['min_power', 'off_delay', 'start_threshold_w', 'stop_threshold_w',
             'start_duration_threshold', 'start_energy_threshold', 'completion_min_seconds',
             'running_dead_zone', 'min_off_gap', 'end_energy_threshold', 'power_off_threshold_w',
             'power_off_delay', 'profile_match_threshold', 'profile_unmatch_threshold',
             'profile_match_interval', 'profile_match_min_duration_ratio',
             'profile_match_max_duration_ratio', 'profile_duration_tolerance', 'duration_tolerance',
             'auto_label_confidence', 'learning_confidence'])
        && settingOk(s, 'min_power') && settingOk(s, 'off_delay') && settingOk(s, 'start_threshold_w')
        && settingOk(s, 'stop_threshold_w') && settingOk(s, 'start_duration_threshold')
        && settingOk(s, 'start_energy_threshold') && settingOk(s, 'completion_min_seconds')
        && settingOk(s, 'running_dead_zone') && settingOk(s, 'min_off_gap')
        && settingOk(s, 'end_energy_threshold') && settingOk(s, 'power_off_threshold_w')
        && settingOk(s, 'power_off_delay') && settingOk(s, 'profile_match_threshold')
        && settingOk(s, 'profile_unmatch_threshold') && settingOk(s, 'profile_match_interval')
        && settingOk(s, 'profile_match_min_duration_ratio')
        && settingOk(s, 'profile_match_max_duration_ratio')
        && settingOk(s, 'profile_duration_tolerance') && settingOk(s, 'duration_tolerance')
        && settingOk(s, 'auto_label_confidence') && settingOk(s, 'learning_confidence');
    }
    // A phase map. Rules cannot loop over a list, so only its type and length are enforced;
    // the element contents are coerced by every consumer (web editor, integration download).
    function phasesOk(p) { return p is list && p.size() <= 50; }
    // A reference-cycle trace, {points: [{o, w}, ...], sampleIntervalSec}. The point list is
    // bounded and its first and last points are type-checked; the interior cannot be iterated
    // by rules, so readers coerce every point (lib/trace.js unpackPoints, the integration's
    // import gate) instead of trusting it.
    function pointOk(p) { return p is map && p.keys().hasOnly(['o', 'w']) && finiteNum(p.o) && finiteNum(p.w); }
    function traceOk(t) {
      return t is map
        && t.keys().hasOnly(['points', 'sampleIntervalSec'])
        && t.points is list && t.points.size() >= 2 && t.points.size() <= 10000
        && pointOk(t.points[0]) && pointOk(t.points[t.points.size() - 1])
        // 0 = unknown: the integration sends 0 when a cycle has no recorded sampling interval.
        && t.sampleIntervalSec is number && t.sampleIntervalSec >= 0 && t.sampleIntervalSec <= 86400;
    }
    function cycleStatsOk(s) {
      return s is map
        && s.keys().hasOnly(['duration', 'energy_wh', 'peak_w', 'mean_w', 'signature'])
        && optFiniteNum(s, 'duration') && optFiniteNum(s, 'energy_wh')
        && optFiniteNum(s, 'peak_w') && optFiniteNum(s, 'mean_w')
        // The local matcher signature: never rendered or imported, so only bounded.
        && (!('signature' in s) || (s.signature is map && s.signature.size() <= 32));
    }
    // A denormalized counter bump must NAME the child document that justifies it, and that
    // child must be created by this very batch (absent before, present after) -- the same proof
    // the brand approved-device counter uses. A bare +1, or one naming a child that already
    // existed, is refused, so a counter can no longer be inflated without a real contribution.
    function newChild(coll, id) {
      return id is string && id.size() >= 1 && id.size() <= 300 && !id.matches('(?s).*/.*')
        && !exists(/databases/$(database)/documents/$(coll)/$(id))
        && existsAfter(/databases/$(database)/documents/$(coll)/$(id));
    }

    // Favorites: a device's favoriteCount and the user's own favorites list move together in
    // one batch (washstore.favoriteDevice). Each side checks the other, so a user can add a
    // device once (+1) and remove it once (-1), never pump the count on its own.
    function favoritesBefore() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('favorites', [])
        : [];
    }
    function favoritesAfter() {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('favorites', []);
    }
    function favoriteCountMoved(devId, delta) {
      return devId is string && devId.size() >= 1 && devId.size() <= 300 && !devId.matches('(?s).*/.*')
        && getAfter(/databases/$(database)/documents/devices/$(devId)).data.get('favoriteCount', 0)
             == get(/databases/$(database)/documents/devices/$(devId)).data.get('favoriteCount', 0) + delta;
    }
    // The favorites list may change by exactly one device per write, with that device's
    // counter moving the same way in the same batch.
    function favoritesStepOk(before, after) {
      let added = after.removeAll(before);
      let removed = before.removeAll(after);
      return after.size() <= 1000
        && ((added.size() == 1 && removed.size() == 0 && after.size() == before.size() + 1
              && favoriteCountMoved(added[0], 1))
            || (removed.size() == 1 && added.size() == 0 && after.size() == before.size() - 1
              && favoriteCountMoved(removed[0], -1)));
    }

    // brands
    match /brands/{brandId} {
      // Pending is public (searchable with an "awaiting approval" tag); removed stays hidden.
      // resource == null when the document doesn't exist; allow those reads so ensureBrand()
      // can check existence via getDoc() without a permission error.
      allow read: if resource == null || resource.data.status in ['approved', 'pending'] || isAdmin()
        || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
      allow create: if canContribute()
        // Exactly the fields the website (ensureBrand) and the integration write.
        && request.resource.data.keys().hasOnly(['brand', 'brand_lc', 'status', 'createdByUid',
             'createdByName', 'createdAt', 'deviceCount', 'cycleCount', 'approvedDeviceCount'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && strLen(request.resource.data.brand, 40)
        && request.resource.data.brand_lc == request.resource.data.brand.lower()
        // The doc id IS the lowercased brand, so the catalog cannot hold an alias under a
        // foreign id.
        && brandId == request.resource.data.brand_lc
        && optName(request.resource.data.get('createdByName', null))
        // Counters must start at zero. approvedDeviceCount especially: it gates brand
        // auto-approval, so a contributor who could seed it non-zero could create a brand and
        // immediately promote it to approved.
        && request.resource.data.get('deviceCount', 0) == 0
        && request.resource.data.get('cycleCount', 0) == 0
        && request.resource.data.get('approvedDeviceCount', 0) == 0
        && request.resource.data.createdAt == request.time;
      // Denormalized counters: contributors may increment deviceCount or cycleCount by
      // exactly +1, in the same batch that creates the device / cycle of THIS brand, which the
      // bump names (lastDeviceId / lastCycleId, see newChild). Decrement is admin-only.
      allow update: if canContribute()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceCount', 'lastDeviceId'])
        && request.resource.data.deviceCount == resource.data.get('deviceCount', 0) + 1
        && newChild('devices', request.resource.data.get('lastDeviceId', null))
        && getAfter(/databases/$(database)/documents/devices/$(request.resource.data.lastDeviceId)).data.brand_lc == brandId;
      allow update: if canContribute()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cycleCount', 'lastCycleId'])
        && request.resource.data.cycleCount == resource.data.get('cycleCount', 0) + 1
        && newChild('cycles', request.resource.data.get('lastCycleId', null))
        && getAfter(/databases/$(database)/documents/cycles/$(request.resource.data.lastCycleId)).data.brand_lc == brandId;
      // Honest approved-device counter, the basis of brand auto-approval.
      //
      // Rules cannot run a query, so they cannot count this brand's approved devices. Instead
      // the bump must NAME the device claiming the credit, which the rule then verifies three
      // ways: the device belongs to THIS brand, it was pending before this write, and it is
      // approved after it (getAfter sees the whole batch). A device can make the
      // pending -> approved transition only once through community action -- the device rule
      // requires `resource.data.status == 'pending'` -- so the same device cannot be counted
      // twice, and a device of another brand cannot be counted at all. That makes the counter
      // as un-gameable as the uid-keyed confirmation docs, without a subcollection.
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['approvedDeviceCount', 'lastApprovedDeviceId'])
        && request.resource.data.approvedDeviceCount == resource.data.get('approvedDeviceCount', 0) + 1
        && request.resource.data.lastApprovedDeviceId is string
        && request.resource.data.lastApprovedDeviceId.size() > 0
        && request.resource.data.lastApprovedDeviceId.size() <= 200
        // No path separator: the id is interpolated into a document path below.
        && !request.resource.data.lastApprovedDeviceId.matches('.*/.*')
        && get(/databases/$(database)/documents/devices/$(request.resource.data.lastApprovedDeviceId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/devices/$(request.resource.data.lastApprovedDeviceId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/devices/$(request.resource.data.lastApprovedDeviceId)).data.brand_lc == brandId;
      // Community auto-promotion: any github user may flip pending -> approved once enough of
      // this brand's devices have been approved. status-only change, mirroring devices/cycles.
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status == 'approved'
        && resource.data.get('approvedDeviceCount', 0) >= brandConfirmThreshold();
      // Admin may create a brand doc directly (faithful ID migration for rename/merge --
      // preserves status/owner/createdAt/counters, which the contributor-create branch cannot).
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Reports on this brand. The parent must exist and the report's target* fields must
      // match this exact object, so a report can only ever point at the brand it hangs off.
      match /reports/{reporterUid} {
        allow create: if reportCreateOk(reporterUid)
          && request.resource.data.targetType == 'brand'
          && request.resource.data.targetId == brandId
          && request.resource.data.targetPath == 'brands/' + brandId
          && exists(/databases/$(database)/documents/brands/$(brandId));
      }
    }

    // devices
    match /devices/{deviceId} {
      // Pending is public (searchable with an "awaiting approval" tag); removed stays hidden.
      // resource == null when the document doesn't exist; allow those reads so ensureDevice()
      // can check existence via getDoc() without a permission error.
      allow read: if resource == null || resource.data.status in ['approved', 'pending'] || isAdmin()
        || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
      allow create: if canContribute()
        // Exactly the fields the website (ensureDevice) and the integration write. ownerId is
        // admin-assigned, so it can never be self-granted at create.
        && request.resource.data.keys().hasOnly(['applianceType', 'brand', 'brand_lc', 'model',
             'model_lc', 'status', 'createdByUid', 'createdByName', 'manualUrl', 'createdAt',
             'favoriteCount', 'confirmCount', 'profileCount', 'cycleCount', 'ratingSum',
             'ratingCount', 'settings'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && applianceTypeOk(request.resource.data.applianceType)
        // The doc id is normalizeToken(type)__brand__model; at least the type must agree.
        && isDeviceId(deviceId) && idOfType(deviceId, request.resource.data.applianceType)
        && strLen(request.resource.data.brand, 40) && strLen(request.resource.data.model, 60)
        && request.resource.data.brand_lc == request.resource.data.brand.lower()
        && request.resource.data.model_lc == request.resource.data.model.lower()
        && request.resource.data.favoriteCount == 0
        && request.resource.data.confirmCount == 0
        && zeroOrAbsent(request.resource.data, 'profileCount')
        && zeroOrAbsent(request.resource.data, 'cycleCount')
        && zeroOrAbsent(request.resource.data, 'ratingSum')
        && zeroOrAbsent(request.resource.data, 'ratingCount')
        && (!('settings' in request.resource.data) || settingsOk(request.resource.data.settings))
        && optUrl(request.resource.data.get('manualUrl', null))
        && optName(request.resource.data.get('createdByName', null))
        && request.resource.data.createdAt == request.time;
      // Device owner (ownerId field, admin-set) may update settings only, and only with a
      // well-formed settings map.
      allow update: if isGithubUser()
        && resource.data.get('ownerId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings'])
        && settingsOk(request.resource.data.settings);
      // favoriteCount: +/-1, one per user. The bump must ride in the same batch that adds
      // this device to (or removes it from) the user's own favorites list, so a user can
      // move it by at most one in each direction (the users rule enforces the other half).
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCount'])
        && ((request.resource.data.favoriteCount == resource.data.get('favoriteCount', 0) + 1
              && !(deviceId in favoritesBefore())
              && deviceId in favoritesAfter())
            || (request.resource.data.favoriteCount == resource.data.get('favoriteCount', 0) - 1
              && deviceId in favoritesBefore()
              && !(deviceId in favoritesAfter())));
      // Denormalized counters: contributors may increment profileCount or cycleCount by
      // exactly +1, in the batch that creates the profile / cycle of THIS device, which the
      // bump names (lastProfileId / lastCycleId). Decrement is admin-only.
      allow update: if canContribute()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileCount', 'lastProfileId'])
        && request.resource.data.profileCount == resource.data.get('profileCount', 0) + 1
        && newChild('profiles', request.resource.data.get('lastProfileId', null))
        && getAfter(/databases/$(database)/documents/profiles/$(request.resource.data.lastProfileId)).data.deviceId == deviceId;
      allow update: if canContribute()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cycleCount', 'lastCycleId'])
        && request.resource.data.cycleCount == resource.data.get('cycleCount', 0) + 1
        && newChild('cycles', request.resource.data.get('lastCycleId', null))
        && getAfter(/databases/$(database)/documents/cycles/$(request.resource.data.lastCycleId)).data.deviceId == deviceId;
      // Honest confirm-count bump: +1 on confirmCount ONLY when the same batch creates
      // this user's confirmation doc that did not already exist. One per uid, un-gameable.
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmCount'])
        && request.resource.data.confirmCount == resource.data.confirmCount + 1
        && !exists(/databases/$(database)/documents/devices/$(deviceId)/confirmations/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/devices/$(deviceId)/confirmations/$(request.auth.uid));
      // Community auto-promotion: any github user may flip pending -> approved once the
      // honest confirmCount has reached the admin-tunable threshold. status-only change.
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status == 'approved'
        && resource.data.confirmCount >= confirmThreshold();
      // Denormalized quality-rating aggregate (ratingSum + ratingCount), maintained in the
      // SAME batch that writes this user's rating doc (mirrors confirmCount, un-gameable).
      // FIRST rating: count +1, sum += new value.
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
        && !exists(/databases/$(database)/documents/devices/$(deviceId)/ratings/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/devices/$(deviceId)/ratings/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/devices/$(deviceId)/ratings/$(request.auth.uid)).data.rating in [1, 2, 3, 4, 5]
        && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
        && request.resource.data.ratingSum == resource.data.get('ratingSum', 0)
             + getAfter(/databases/$(database)/documents/devices/$(deviceId)/ratings/$(request.auth.uid)).data.rating;
      // EDIT an existing rating: count unchanged, sum += (new - old).
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum'])
        && exists(/databases/$(database)/documents/devices/$(deviceId)/ratings/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/devices/$(deviceId)/ratings/$(request.auth.uid)).data.rating in [1, 2, 3, 4, 5]
        && request.resource.data.ratingSum == resource.data.get('ratingSum', 0)
             - get(/databases/$(database)/documents/devices/$(deviceId)/ratings/$(request.auth.uid)).data.rating
             + getAfter(/databases/$(database)/documents/devices/$(deviceId)/ratings/$(request.auth.uid)).data.rating;
      // Admin may create a device doc directly (faithful ID migration for rename/merge --
      // preserves status/owner/createdAt/counters, which the contributor-create branch cannot).
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // One-way confirmation doc (create-only, own uid); the un-gameable source of truth.
      match /confirmations/{uid} {
        allow read: if true;
        allow create: if canContribute() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Optional 5-star quality score (information only; never affects approval).
      match /ratings/{uid} {
        allow read: if true;
        allow create, update: if canContribute() && request.auth.uid == uid
          && request.resource.data.rating in [1, 2, 3, 4, 5];
        allow delete: if false;
      }

      // Reports on this device (parent must exist; target* fields bound to this object).
      match /reports/{reporterUid} {
        allow create: if reportCreateOk(reporterUid)
          && request.resource.data.targetType == 'device'
          && request.resource.data.targetId == deviceId
          && request.resource.data.targetPath == 'devices/' + deviceId
          && exists(/databases/$(database)/documents/devices/$(deviceId));
      }
    }

    // profiles
    match /profiles/{profileId} {
      // Pending is public (browseable with an "awaiting approval" tag), like the
      // brand/device catalog; removed stays hidden. Cycles (the data) stay moderated.
      // resource == null when the document doesn't exist; allow those reads so ensureProfile()
      // can check existence via getDoc() without a permission error.
      allow read: if resource == null || resource.data.status in ['approved', 'pending'] || isAdmin()
        || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
      allow create: if canContribute()
        // Exactly the fields the website (ensureProfile) and the integration write; no
        // ownerId (admin-assigned) and no pre-seeded counters.
        && request.resource.data.keys().hasOnly(['deviceId', 'applianceType', 'program',
             'program_lc', 'description', 'status', 'createdByUid', 'createdAt', 'cycleCount',
             'phases', 'phaseSourceCycleId', 'phasesSchemaVersion'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'pending'
        // Parent binding: the device must exist and the profile id must be
        // <deviceId>__<program token>, so a profile cannot be filed under one device while
        // naming another, or under an id unrelated to its device.
        && isDeviceId(request.resource.data.deviceId)
        && profileId.matches(request.resource.data.deviceId + '__' + tok())
        && exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId))
        // The website derives applianceType from the device id (washer-dryer), the
        // integration sends the enum (washer_dryer); either must agree with the device id.
        && (!('applianceType' in request.resource.data)
            || (request.resource.data.applianceType in ['washer', 'dryer', 'dishwasher', 'washer_dryer', 'washer-dryer']
                && idOfType(request.resource.data.deviceId, request.resource.data.applianceType)))
        && strLen(request.resource.data.program, 60)
        && request.resource.data.program_lc == request.resource.data.program.lower()
        && optText(request.resource.data.get('description', null), 2000)
        && zeroOrAbsent(request.resource.data, 'cycleCount')
        && (!('phases' in request.resource.data) || phasesOk(request.resource.data.phases))
        && optText(request.resource.data.get('phaseSourceCycleId', null), 128)
        && (!('phasesSchemaVersion' in request.resource.data)
            || (request.resource.data.phasesSchemaVersion is int
                && request.resource.data.phasesSchemaVersion >= 1
                && request.resource.data.phasesSchemaVersion <= 100))
        && request.resource.data.createdAt == request.time;
      // Denormalized counter: contributors may increment cycleCount by exactly +1, in the
      // batch that creates a cycle of THIS profile, which the bump names (lastCycleId).
      // Decrement is admin-only.
      allow update: if canContribute()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cycleCount', 'lastCycleId'])
        && request.resource.data.cycleCount == resource.data.get('cycleCount', 0) + 1
        && newChild('cycles', request.resource.data.get('lastCycleId', null))
        && getAfter(/databases/$(database)/documents/cycles/$(request.resource.data.lastCycleId)).data.profileId == profileId;
      // Profile owner (ownerId) or parent device owner may update phases only, and only with
      // a bounded phase list.
      allow update: if isGithubUser()
        && resource.data.get('ownerId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phases'])
        && phasesOk(request.resource.data.phases);
      allow update: if isGithubUser()
        && exists(/databases/$(database)/documents/devices/$(resource.data.deviceId))
        && get(/databases/$(database)/documents/devices/$(resource.data.deviceId)).data.get('ownerId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phases'])
        && phasesOk(request.resource.data.phases);
      // Admin may create a profile doc directly (faithful ID migration for rename/merge --
      // preserves status/owner/createdAt/counters, which the contributor-create branch cannot).
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Reports on this profile (parent must exist; target* fields bound to this object).
      match /reports/{reporterUid} {
        allow create: if reportCreateOk(reporterUid)
          && request.resource.data.targetType == 'profile'
          && request.resource.data.targetId == profileId
          && request.resource.data.targetPath == 'profiles/' + profileId
          && exists(/databases/$(database)/documents/profiles/$(profileId));
      }
    }

    // cycles (reference golden cycles) - community-voted like devices (no admin review)
    match /cycles/{cycleId} {
      function isOwner() { return isSignedIn() && resource != null && resource.data.uploaderUid == request.auth.uid; }
      // Pending is public (browseable with an "awaiting approval" tag) so the
      // community can confirm it; removed stays hidden.
      allow read: if resource == null || resource.data.status in ['approved', 'pending'] || isOwner() || isAdmin();
      allow create: if canContribute()
        // Exactly the fields the integration (store_client.upload_reference_cycle) and the
        // website (uploadReferenceCycle) write; no forged rating aggregate, no approval state.
        && request.resource.data.keys().hasOnly(['profileId', 'deviceId', 'brand_lc', 'program_lc',
             'applianceType', 'uploaderUid', 'uploaderName', 'status', 'rejectionReason',
             'traceHash', 'trace', 'stats', 'cycleSchemaVersion', 'downloads', 'commentCount',
             'confirmCount', 'ratingSum', 'ratingCount', 'qc', 'createdAt'])
        && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('rejectionReason', null) == null
        && request.resource.data.downloads == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.confirmCount == 0
        && zeroOrAbsent(request.resource.data, 'ratingSum')
        && zeroOrAbsent(request.resource.data, 'ratingCount')
        && request.resource.data.cycleSchemaVersion is number
        && request.resource.data.cycleSchemaVersion >= 1 && request.resource.data.cycleSchemaVersion <= 100
        && applianceTypeOk(request.resource.data.applianceType)
        // Parent binding: the profile must exist, belong to the named device, and the ids
        // must nest (<device>__<program>) under the cycle's own appliance type, so a cycle
        // cannot be attached to a program it does not belong to or to nothing at all.
        && isDeviceId(request.resource.data.deviceId)
        && idOfType(request.resource.data.deviceId, request.resource.data.applianceType)
        && isProfileId(request.resource.data.profileId)
        && request.resource.data.profileId.matches(request.resource.data.deviceId + '__' + tok())
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.profileId))
        && get(/databases/$(database)/documents/profiles/$(request.resource.data.profileId)).data.deviceId == request.resource.data.deviceId
        && strLen(request.resource.data.brand_lc, 120)
        && strLen(request.resource.data.program_lc, 120)
        && request.resource.data.qc is int && request.resource.data.qc >= 1 && request.resource.data.qc <= 3
        && traceOk(request.resource.data.trace)
        && cycleStatsOk(request.resource.data.stats)
        && optName(request.resource.data.get('uploaderName', null))
        // The integration's content-hash id is mirrored in traceHash; they must agree.
        && (!('traceHash' in request.resource.data) || request.resource.data.traceHash == cycleId)
        && request.resource.data.createdAt == request.time;
      // public download bump: exactly +1 and no other field
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
        && request.resource.data.downloads == resource.data.downloads + 1;
      // comment count +/-1 by a github user
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && (request.resource.data.commentCount == resource.data.commentCount + 1
            || request.resource.data.commentCount == resource.data.commentCount - 1);
      // Honest confirm-count bump: +1 only in the batch that creates this user's
      // one-per-uid confirmation doc (un-gameable), exactly like devices.
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmCount'])
        && request.resource.data.confirmCount == resource.data.confirmCount + 1
        && !exists(/databases/$(database)/documents/cycles/$(cycleId)/confirmations/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/cycles/$(cycleId)/confirmations/$(request.auth.uid));
      // Community auto-promotion: any github user may flip pending -> approved once
      // the honest confirmCount reaches the admin-tunable threshold. status-only change.
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status == 'approved'
        && resource.data.confirmCount >= confirmThreshold();
      // Denormalized rating aggregate (ratingSum + ratingCount), maintained in the SAME
      // batch that writes this user's rating doc so the aggregate is un-gameable (mirrors
      // confirmCount). FIRST rating: count +1, sum += the new rating value. getAfter reads
      // the rating doc's post-batch value; get('field', 0) tolerates docs predating this.
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
        && !exists(/databases/$(database)/documents/cycles/$(cycleId)/ratings/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/cycles/$(cycleId)/ratings/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/cycles/$(cycleId)/ratings/$(request.auth.uid)).data.rating in [1, 2, 3, 4, 5]
        && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
        && request.resource.data.ratingSum == resource.data.get('ratingSum', 0)
             + getAfter(/databases/$(database)/documents/cycles/$(cycleId)/ratings/$(request.auth.uid)).data.rating;
      // EDIT an existing rating: count unchanged (not in the write), sum += (new - old).
      allow update: if isGithubUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum'])
        && exists(/databases/$(database)/documents/cycles/$(cycleId)/ratings/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/cycles/$(cycleId)/ratings/$(request.auth.uid)).data.rating in [1, 2, 3, 4, 5]
        && request.resource.data.ratingSum == resource.data.get('ratingSum', 0)
             - get(/databases/$(database)/documents/cycles/$(cycleId)/ratings/$(request.auth.uid)).data.rating
             + getAfter(/databases/$(database)/documents/cycles/$(cycleId)/ratings/$(request.auth.uid)).data.rating;
      // Admin may create a cycle doc directly (faithful ID migration for move/merge --
      // preserves status/owner/createdAt/counters, which the contributor-create branch cannot).
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if (isSignedIn() && isOwner()) || isAdmin();

      // One-way confirmation doc (create-only, own uid); the un-gameable vote source.
      match /confirmations/{uid} {
        allow read: if true;
        allow create: if canContribute() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if canContribute()
          && request.resource.data.authorUid == request.auth.uid
          && strLen(request.resource.data.text, 1000)
          && (request.resource.data.authorName == null
              || (request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100))
          && request.resource.data.createdAt == request.time
          && (!('parentId' in request.resource.data)
              || request.resource.data.parentId == null
              || request.resource.data.parentId is string);
        allow delete: if (isSignedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
        allow update: if false;

        // Reports on this comment (parent comment must exist; target* bound to this path).
        match /reports/{reporterUid} {
          allow create: if reportCreateOk(reporterUid)
            && request.resource.data.targetType == 'comment'
            && request.resource.data.targetId == commentId
            && request.resource.data.parentCycleId == cycleId
            && request.resource.data.targetPath == 'cycles/' + cycleId + '/comments/' + commentId
            && exists(/databases/$(database)/documents/cycles/$(cycleId)/comments/$(commentId));
        }
      }

      match /ratings/{uid} {
        allow read: if true;
        allow create, update: if canContribute() && request.auth.uid == uid
          && request.resource.data.rating in [1, 2, 3, 4, 5];
        allow delete: if false;
      }

      // Reports on this cycle (parent must exist; target* fields bound to this object).
      match /reports/{reporterUid} {
        allow create: if reportCreateOk(reporterUid)
          && request.resource.data.targetType == 'cycle'
          && request.resource.data.targetId == cycleId
          && request.resource.data.targetPath == 'cycles/' + cycleId
          && exists(/databases/$(database)/documents/cycles/$(cycleId));
      }
    }

    // admins collection - existence == is admin; no client writes; check-own-only read
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // users collection - self-service cannot touch moderation fields.
    // NB: `status`/`banReason`/`bannedAt`/`bannedBy` (ban state) and
    // `removedContentCount`/`lastRemovalAt` (repeat-offender strike counter, bumped by an
    // admin each time one of this user's contributions is removed) are all admin-only --
    // the self-service branch's hasOnly() allowlist deliberately excludes them.
    match /users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if isGithubUser() && request.auth.uid == uid
        // Exactly what ensureUserProfile writes: no moderation field (strike counter, ban
        // state) can be pre-seeded, and favorites start empty (they move with favoriteCount).
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt',
             'lastSeen', 'status', 'favorites', 'githubLogin'])
        && request.resource.data.uid == uid
        && request.resource.data.get('status', 'active') == 'active'
        && request.resource.data.get('favorites', []).size() == 0;
      allow update: if isAdmin()
        || (isGithubUser() && request.auth.uid == uid
            // Self-service updates: name/photo/activity fields + githubLogin (set at sign-in).
            // status must not change (only admin may ban/unban).
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['displayName', 'photoURL', 'lastSeen', 'favorites', 'githubLogin'])
            && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
            // A favorites change is one device at a time, tied to its favoriteCount.
            && (!('favorites' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.favorites is list
                    && favoritesStepOk(resource.data.get('favorites', []), request.resource.data.favorites))));
      allow delete: if isAdmin();
    }

    // Content reports (community moderation) -- read / resolve side.
    //
    // A `reports/{reporterUid}` subcollection hangs off every reportable object -- brands,
    // devices, profiles, cycles, and cycle comments. One report per user per object (the doc
    // id IS the reporter uid, un-gameable; create-only for non-admins so re-reporting is a
    // no-op). CREATE is defined per-parent below so each create can verify the parent object
    // EXISTS and that the denormalized target* fields match the report's real location.
    //
    // This RECURSIVE-WILDCARD match ({path=**}) is required to authorize the admin
    // *collection-group* query over every `reports` subcollection at any depth (a per-parent
    // rule does NOT authorize a collection-group query -- see the Firestore docs). It also
    // covers per-report reads and admin resolve/delete.
    match /{path=**}/reports/{reporterUid} {
      // Reports are private: only admins (the review queue) and the reporter themselves
      // (so the UI can show an "already reported" state) may read them.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == reporterUid);
      // Only admins resolve (status -> resolved) or delete reports.
      allow update, delete: if isAdmin();
    }

    // site config (e.g. maintenance flag) - world-readable so clients can gate; admin-only writes
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Aggregate usage counters (daily_{YYYYMMDD} + totals documents). Writes are
    // anonymous (there is no backend to own them, and browse/download events are
    // unauthenticated) but bounded: each write may only touch the known counter fields
    // (+ a short `date` label) and may raise the SUM of all counters by at most 1 -- one
    // +1 per event. This blocks one-shot/arbitrary inflation, junk fields, decrements,
    // and non-numeric values. It cannot stop a client looping +1 forever; true rate
    // limiting needs Cloud Functions (see SECURITY.md). Reads are admin-only.
    match /analytics/{docId} {
      // Sum of all known counters in a doc (absent fields default to 0).
      function counterSum(d) {
        return d.get('brand_views', 0) + d.get('device_views', 0) + d.get('profile_views', 0)
          + d.get('cycle_details', 0) + d.get('searches', 0) + d.get('favorites', 0)
          + d.get('device_confirms', 0) + d.get('device_ratings', 0) + d.get('cycle_ratings', 0)
          + d.get('downloads', 0);
      }
      function analyticsKeysOk(keys) {
        return keys.hasOnly(['brand_views', 'device_views', 'profile_views', 'cycle_details',
          'searches', 'favorites', 'device_confirms', 'device_ratings', 'cycle_ratings',
          'downloads', 'date']);
      }
      function dateOk() {
        return request.resource.data.get('date', '') is string
          && request.resource.data.get('date', '').size() <= 12;
      }
      allow read: if isAdmin();
      allow create: if analyticsKeysOk(request.resource.data.keys())
        && counterSum(request.resource.data) <= 1
        && dateOk();
      allow update: if analyticsKeysOk(request.resource.data.diff(resource.data).affectedKeys())
        && counterSum(request.resource.data) >= counterSum(resource.data)
        && counterSum(request.resource.data) <= counterSum(resource.data) + 1
        && dateOk();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
